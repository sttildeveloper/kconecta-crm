APP_NAME=Kconecta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kconecta_schema
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.buzondecorreo.com
MAIL_PORT=465
MAIL_USERNAME=info@kconecta.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@kconecta.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local orchestrator workers (optional)
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_API_KEY=
ORCH_DEEPSEEK_PROVIDER=openai_compatible
ORCH_DEEPSEEK_ENDPOINT=
ORCH_DEEPSEEK_MODEL=deepseek-coder
ORCH_DEEPSEEK_API_KEY=
ORCH_DEEPSEEK_TIMEOUT=45
ORCH_MISTRAL_PROVIDER=openai_compatible
ORCH_MISTRAL_ENDPOINT=
ORCH_MISTRAL_MODEL=mistral
ORCH_MISTRAL_API_KEY=
ORCH_MISTRAL_TIMEOUT=45
ORCH_GEMMA_PROVIDER=openai_compatible
ORCH_GEMMA_ENDPOINT=
ORCH_GEMMA_MODEL=gemma
ORCH_GEMMA_API_KEY=
ORCH_GEMMA_TIMEOUT=45
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
FORCE_PROVIDER_EMAIL_VERIFICATION=true
VIDEO_MAX_UPLOAD_MB=150
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,http://localhost:8081
